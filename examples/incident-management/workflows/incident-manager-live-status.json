{
  "schemaVersion": 2,
  "name": "Incident manager live status",
  "description": "Load approved operational resources and return a bounded incident-status result to the Agent.",
  "steps": [
    {
      "id": "entry",
      "kind": "entry",
      "label": "Entry",
      "position": { "x": 100, "y": 180 },
      "data": {}
    },
    {
      "id": "query_open_incidents",
      "kind": "capability",
      "label": "Load open incidents",
      "position": { "x": 380, "y": 180 },
      "data": {
        "actionKey": "query_data_resource",
        "inputMapping": {
          "resource_key": "incidents",
          "allowed_resource_keys": ["incidents"],
          "mode": "list",
          "filters": [{ "field": "status", "operator": "in", "value": ["open", "monitoring"] }],
          "select": ["external_id", "category", "severity", "status", "location_name", "casualty_count", "summary", "occurred_at"],
          "sort": [{ "field": "occurred_at", "direction": "desc" }],
          "limit": 10
        },
        "outputVariable": "open_incidents"
      }
    },
    {
      "id": "query_active_stations",
      "kind": "capability",
      "label": "Load active stations",
      "position": { "x": 660, "y": 180 },
      "data": {
        "actionKey": "query_data_resource",
        "inputMapping": {
          "resource_key": "rescue_stations",
          "allowed_resource_keys": ["rescue_stations"],
          "mode": "list",
          "filters": [{ "field": "status", "operator": "equals", "value": "active" }],
          "select": ["id", "name", "region", "status", "available_vehicles", "capabilities"],
          "sort": [{ "field": "name", "direction": "asc" }],
          "limit": 10
        },
        "outputVariable": "active_stations"
      }
    },
    {
      "id": "query_available_rescuers",
      "kind": "capability",
      "label": "Load available rescuers",
      "position": { "x": 940, "y": 180 },
      "data": {
        "actionKey": "query_data_resource",
        "inputMapping": {
          "resource_key": "rescuers",
          "allowed_resource_keys": ["rescuers"],
          "mode": "list",
          "filters": [{ "field": "status", "operator": "equals", "value": "available" }],
          "select": ["id", "station_id", "name", "role", "status", "certifications", "shift_ends_at"],
          "sort": [{ "field": "name", "direction": "asc" }],
          "limit": 25
        },
        "outputVariable": "available_rescuers"
      }
    },
    {
      "id": "query_recent_earthquakes",
      "kind": "capability",
      "label": "Load recent earthquakes",
      "position": { "x": 1220, "y": 180 },
      "data": {
        "actionKey": "query_data_resource",
        "inputMapping": {
          "resource_key": "earthquake_records",
          "allowed_resource_keys": ["earthquake_records"],
          "mode": "list",
          "select": ["external_id", "magnitude", "region", "depth_km", "occurred_at"],
          "sort": [{ "field": "occurred_at", "direction": "desc" }],
          "limit": 10
        },
        "outputVariable": "recent_earthquakes"
      }
    },
    {
      "id": "compose_status",
      "kind": "aiTask",
      "label": "Compose operational status",
      "position": { "x": 1500, "y": 180 },
      "data": {
        "systemPrompt": "Summarize only the supplied operational records. Do not invent incidents, people, capacity, or recommendations.",
        "inputTemplate": "Open incidents: {{open_incidents}}\nActive stations: {{active_stations}}\nAvailable rescuers: {{available_rescuers}}\nRecent earthquakes: {{recent_earthquakes}}",
        "outputVariable": "manager_status",
        "temperature": 0.1,
        "maxTokens": 900
      }
    },
    {
      "id": "result",
      "kind": "result",
      "label": "Return status",
      "position": { "x": 1780, "y": 180 },
      "data": {
        "resultTemplate": "{{manager_status}}",
        "statusValue": "completed"
      }
    }
  ],
  "transitions": [
    { "id": "entry_incidents", "sourceStepId": "entry", "targetStepId": "query_open_incidents" },
    { "id": "incidents_stations", "sourceStepId": "query_open_incidents", "targetStepId": "query_active_stations" },
    { "id": "stations_rescuers", "sourceStepId": "query_active_stations", "targetStepId": "query_available_rescuers" },
    { "id": "rescuers_earthquakes", "sourceStepId": "query_available_rescuers", "targetStepId": "query_recent_earthquakes" },
    { "id": "earthquakes_compose", "sourceStepId": "query_recent_earthquakes", "targetStepId": "compose_status" },
    { "id": "compose_result", "sourceStepId": "compose_status", "targetStepId": "result" }
  ],
  "annotations": [],
  "conversationMemoryPolicy": "inherit",
  "policies": {},
  "compiler": { "version": 1 },
  "viewport": { "x": 60, "y": 80, "zoom": 0.62 }
}
